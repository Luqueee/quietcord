{
  "name": "disc-chat-tui",
  "version": "0.1.0",
  "description": "Terminal UI for sending messages to a Discord voice channel chat",
  "type": "module",
  "bin": {
    "disc-chat-tui": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/cli.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^5.0.1",
    "meow": "^13.2.0",
    "react": "^18.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.31",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3"
  }
}
